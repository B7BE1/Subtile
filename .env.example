# ============================================================================
# متغيرات البيئة — تُضبط من Vercel Dashboard > Project > Settings > Environment
# Variables. لا تضع القيم الحقيقية هنا أو في أي ملف يُرفع لـ GitHub.
# ============================================================================

# إجباري — مطلوب لتشغيل api/search.js و api/season.js
# (api/metadata.js لم يعد يستخدم TMDB — Cinemeta + Jikan/AniList فقط)
# احصل عليه من: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# اختياري — لتفعيل مزود ترجمات حقيقي (بدونه: بيانات تجريبية فقط)
# https://www.opensubtitles.com/en/consumers
OPENSUBTITLES_API_KEY=

# اختياري — مزود ترجمات ثانٍ
# https://subdl.com/dashboard/api
SUBDL_API_KEY=

# اختياري — لتفعيل قاعدة البيانات المحلية (بحث هجين + ترجمات مرفوعة من المستخدمين)
# نفس المتغيرات تُستخدم أيضاً لتفعيل الـ cache في api/metadata.js (جدول metadata_cache
# في sql/schema.sql). بدونها: api/metadata.js يعمل بدون cache (يجلب مباشرة من
# Cinemeta/Jikan في كل طلب).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# اختياري — لتفعيل فحص الترجمات بـ VirusTotal
# https://www.virustotal.com/gui/my-apikey (مجاني: 4 طلبات/دقيقة)
VIRUSTOTAL_API_KEY=
